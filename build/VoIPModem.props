<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared settings for every VoIPModem project (VoIPModemLib, VoIPModem,
  VoIPModemManager, VoIPModem.Tests, libv90modem). Imported right after Microsoft.Cpp.props,
  so $(Platform) and $(Configuration) are known.

  - One output folder per platform/configuration at the repo root
    (x64\Release, Win32\Release, ...), whether a project is built through
    the solution or on its own.
  - PJSIP's location, include paths and library name. pjproject names its
    static library by CPU, platform and configuration only
    (libpjproject-<cpu>-<platform>-vc14-<config>-Static.lib, "vc14" fixed
    whatever the toolset), so a build for another Windows target must come
    from a separate pjproject tree: the XP configurations use
    third_party\pjproject-xp (see VoIPModem.Toolset.props).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VoIPModemRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</VoIPModemRoot>
    <OutDir>$(VoIPModemRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\</IntDir>

    <PjRoot Condition="'$(PjRoot)'=='' and '$(VoIPModemXP)'=='true'">$(VoIPModemRoot)third_party\pjproject-xp\</PjRoot>
    <PjRoot Condition="'$(PjRoot)'==''">$(VoIPModemRoot)third_party\pjproject\</PjRoot>
    <PjCpu Condition="'$(Platform)'=='x64'">x86_64</PjCpu>
    <PjCpu Condition="'$(Platform)'=='Win32'">i386</PjCpu>
    <PjConfig Condition="'$(VoIPModemDebug)'=='true'">Debug-Static</PjConfig>
    <PjConfig Condition="'$(VoIPModemDebug)'!='true'">Release-Static</PjConfig>
    <PjLib>libpjproject-$(PjCpu)-$(Platform)-vc14-$(PjConfig).lib</PjLib>

    <!-- XP is NT 5.1 (32-bit only); XP x64 and Server 2003 are NT 5.2. -->
    <XpWinNT Condition="'$(Platform)'=='Win32'">0x0501</XpWinNT>
    <XpWinNT Condition="'$(Platform)'=='x64'">0x0502</XpWinNT>
    <XpSubsystem Condition="'$(Platform)'=='Win32'">5.01</XpSubsystem>
    <XpSubsystem Condition="'$(Platform)'=='x64'">5.02</XpSubsystem>
    <PjIncludes>$(PjRoot)pjlib\include;$(PjRoot)pjlib-util\include;$(PjRoot)pjmedia\include;$(PjRoot)pjnath\include;$(PjRoot)pjsip\include</PjIncludes>
  </PropertyGroup>

  <!-- third_party: <nlohmann/json.hpp> (vendored, MIT) for the control API.
       /utf-8: the sources are UTF-8 (the Manager's texts have dashes and
       symbols); without it MSVC reads them in the system code page. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(VoIPModemRoot)third_party;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Used by the executables that link PJSIP (VoIPModem, the tests); static
       libraries ignore <Link>. The Manager sets VoIPModemNoPjsip. -->
  <ItemDefinitionGroup Condition="'$(VoIPModemNoPjsip)'!='true'">
    <Link>
      <AdditionalLibraryDirectories>$(PjRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(PjLib);ws2_32.lib;wsock32.lib;ole32.lib;dsound.lib;winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- XP / Server 2003: no Vista+ APIs at compile time, and an .exe header
       that those systems will load. -->
  <ItemDefinitionGroup Condition="'$(VoIPModemXP)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>_WIN32_WINNT=$(XpWinNT);WINVER=$(XpWinNT);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <MinimumRequiredVersion>$(XpSubsystem)</MinimumRequiredVersion>
    </Link>
  </ItemDefinitionGroup>
</Project>
