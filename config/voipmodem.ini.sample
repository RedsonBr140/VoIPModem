; VoIPModem configuration.
; Copy this file to voipmodem.ini next to the executable (or pass a path
; as the first command-line argument) and adjust as needed. See
; docs/ARCHITECTURE.md for what each part does.

; VoIPModem Manager (Settings, Line properties, New line) edits this file
; in place: it changes only the keys it sets and keeps comments.

[Logging]
; One of: Error, Warn, Info, Debug. Debug includes PJSIP's own SIP/RTP
; trace, which is what you want when diagnosing a call.
Level=Info
; Relative to this file's folder.
File=voipmodem.log
; Rotate at this size (KB): voipmodem.log -> .1 -> ... -> .<Keep>. 0 = never.
; RotateKB=0
; Keep=5
; 1 = log every AT command line and response at Info.
; TraceAT=0

; Process-wide SIP transport. Required (nonzero) for any modem line's
; SipServer setting below to do anything: without it, every line falls
; back to NullCallController (ATD/ATA honestly fail). One port is shared
; by every line's SIP account.
[SIP]
LocalPort=5060
; UDP (default) or TCP.
; Transport=UDP
; Default registrar for lines without their own SipServer.
; Server=sip.example.com:5060
; Realm=*
; RegisterExpiry=300
; 0 = lines start unregistered (register them from the Manager).
; RegisterOnStart=1

; The call audio path. See docs/ARCHITECTURE.md "Media path" before
; changing these: modems are less forgiving than voice.
; [Media]
; PCMU (mu-law) or PCMA (A-law), offered first; both are offered.
; Codec=PCMU
; Initial jitter buffer depth; the others scale from it. Raise on lossy trunks.
; JitterBufferMs=160
; RtpPort=4000
; RtpPortRange=0
; EchoCanceller=0

; The control API (docs/CONTROL_API.md) that VoIPModem Manager uses.
; Port=0 turns it off. Keep BindAddress=127.0.0.1 unless the Manager runs
; on another computer, and then set a Password (it is sent in clear text).
; [Control]
; Port=7880
; BindAddress=127.0.0.1
; Password=

; Modem settings for every line that does not set its own: Modulations,
; AutoAnswerRingCount, ErrorControl, Compression, BaudRate,
; Identification, SipServer, SipRealm.
; [Defaults]
; AutoAnswerRingCount=1

; --- Single modem line ---
; A bare [Modem] section configures exactly one modem line.
[Modem]
; The COM port VoIPModem opens: one side of a com0com pair. Windows'
; modem driver (and RAS) binds to the OTHER side of the pair.
ComPort=COM3

; DTE-to-modem serial speed on the virtual port. Not the modem-to-modem
; rate, which the modems negotiate and CONNECT reports.
BaudRate=115200

; Text returned by ATI.
Identification=VoIPModem Virtual Modem

; S0 register initial value (auto-answer ring count). 0 disables
; auto-answer (ATA must be typed); a value > 0 answers after that many
; RINGs. A modem-bank line that RAS answers on its own can use either.
AutoAnswerRingCount=0

; Modulations this line's modem offers, comma-separated: V21, V22
; (V.22 and V.22bis), V32BIS, V34, V90, V92, BELL103, BELL212A. Leave it
; out (or empty) for the default: V.92, V.90, V.34, V.32bis, V.22bis,
; V.22 and V.21. Example, to keep calls out of V.90/V.92 PCM:
; Modulations=V21,V22,V32BIS,V34

; V.42 error control (LAPM) and, within it, V.42bis/V.44 compression.
; ErrorControl=0 sends plain start-stop characters instead.
; ErrorControl=1
; Compression=1

; 0 = out of service: the extension is not registered, so no calls come in.
; InService=1

; 1 = play the call's audio (both directions mixed), plus the dial tone
; and DTMF digits when dialling, on this PC's default sound output, like
; a modem speaker. Enable it on one line at most.
; EnableLocalAudio=0

; SIP registration for this line's extension. Leave SipServer empty (or
; omit these keys) to keep this line on NullCallController. Do not
; commit real credentials: voipmodem.ini itself is gitignored.
; SipServer=sip.example.com:5060
; SipExtension=1001
; SipPassword=changeme
; SipRealm=*   ; default; only needed if Asterisk challenges with a specific realm

; --- Multiple modem lines ---
; To run several lines (a modem bank), delete the [Modem] section above
; and add one [Modem.<name>] section per line instead, each with its own
; ComPort and SIP extension. <name> only labels that line's log output.
; Each line runs on its own thread with its own modem; all share the
; one [SIP] LocalPort transport.
;
; [Modem.Line1]
; ComPort=COM3
; BaudRate=115200
; Identification=VoIPModem Virtual Modem (Line1)
; AutoAnswerRingCount=1
; SipServer=sip.example.com:5060
; SipExtension=1001
; SipPassword=changeme
;
; [Modem.Line2]
; ComPort=COM5
; BaudRate=115200
; Identification=VoIPModem Virtual Modem (Line2)
; AutoAnswerRingCount=1
; SipServer=sip.example.com:5060
; SipExtension=1002
; SipPassword=changeme-too
