; VoIPModem configuration — Phase 1 (serial/Hayes skeleton) subset only.
; Copy this file to voipmodem.ini next to the executable (or pass a path
; as the first command-line argument) and adjust as needed.
;
; SIP/RTP/DSP settings described in docs/PROJECT_SPEC.md section 5 are not
; yet read by any code and are intentionally omitted here; they will be
; added per modem instance alongside Phase 2 (SIP), where each instance
; gets its own SIP extension/credentials the same way it already gets its
; own ComPort below.

[Logging]
; One of: Error, Warn, Info, Debug
Level=Info
File=voipmodem.log

; --- Single modem line (legacy Phase 1 form) ---
; A bare [Modem] section configures exactly one modem line and is still
; fully supported. Use this if you only have one COM port to dial through.
[Modem]
; Virtual COM port created by com0com (see docs/PROJECT_SPEC.md section 3).
ComPort=COM3

; Local DTE-to-modem serial speed. This is NOT the negotiated modem-to-modem
; connection speed, which has no meaning yet since there is no DSP/modulation
; backend (Phase 4).
BaudRate=115200

; Text returned by ATI.
Identification=VoIPModem Virtual Modem (Phase 1)

; S0 register initial value (auto-answer ring count). Stored and queryable
; via ATS0=/ATS0?, but nothing currently triggers auto-answer on a RING
; event, since there is no SIP layer to produce one.
AutoAnswerRingCount=0

; --- Multiple modem lines ---
; To run more than one modem line at once, delete the [Modem] section
; above and add one [Modem.<name>] section per line instead, each with
; its own ComPort (and, from Phase 2 on, its own SIP extension). <name>
; is only used to label that line's log output — pick anything readable.
; Each line runs on its own thread with its own state machine, entirely
; independent of the others. See docs/ARCHITECTURE.md "Multiple modem
; instances".
;
; [Modem.Line1]
; ComPort=COM3
; BaudRate=115200
; Identification=VoIPModem Virtual Modem (Line1)
; AutoAnswerRingCount=0
;
; [Modem.Line2]
; ComPort=COM5
; BaudRate=115200
; Identification=VoIPModem Virtual Modem (Line2)
; AutoAnswerRingCount=0
